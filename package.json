{
    "name": "shared-menu",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "deploy": "npm test -- --run && wrangler d1 migrations apply shared-menu --remote && wrangler deploy",
        "dev": "wrangler dev",
        "start": "wrangler dev",
        "test": "vitest",
        "cf-typegen": "wrangler types --include-runtime=false",
        "format": "prettier --write \"src/**/*.ts\"",
        "db:migration:create": "wrangler d1 migrations create shared-menu",
        "db:migrations:list:local": "wrangler d1 migrations list shared-menu --local",
        "db:migrations:list:remote": "wrangler d1 migrations list shared-menu --remote",
        "db:migrations:apply:local": "wrangler d1 migrations apply shared-menu --local",
        "db:migrations:apply:remote": "wrangler d1 migrations apply shared-menu --remote"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.22.0",
        "@cloudflare/workers-types": "^5.20260904.1",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11",
        "wrangler": "^4.129.0"
    }
}
